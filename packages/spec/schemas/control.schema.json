{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsor:schema:1.3:control",
  "title": "control",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "in_review",
        "active",
        "stale_authority",
        "suspended",
        "retired"
      ]
    },
    "operation": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/operationId"
    },
    "condition": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/cel"
    },
    "effect": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "deny": {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "reason"
          ]
        },
        "require_approval": {
          "$ref": "urn:dsor:schema:1.3:common#/$defs/approvalRequirement"
        },
        "require_step_up": {
          "type": "object",
          "properties": {
            "acr": {
              "type": "string"
            }
          },
          "required": [
            "acr"
          ]
        },
        "require_verification": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "authority": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/authorityReference"
    },
    "owner": {
      "type": "string"
    },
    "compiled_by": {
      "type": "string"
    },
    "reviewed_by": {
      "type": "string"
    },
    "on_stale": {
      "enum": [
        "enforce_and_flag",
        "require_approval",
        "deny"
      ]
    },
    "stale_grace": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/duration"
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "input": {
            "type": "object"
          },
          "state": {
            "type": "object"
          },
          "rates": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?$"
            },
            "description": "units of currency per one unit of the control currency, pinned for this vector"
          },
          "expect": {
            "$ref": "urn:dsor:schema:1.3:common#/$defs/outcome"
          }
        },
        "required": [
          "expect"
        ]
      }
    },
    "effective_from": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/timestamp"
    },
    "extensions": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/extensions"
    }
  },
  "required": [
    "id",
    "version",
    "status",
    "operation",
    "condition",
    "effect",
    "authority",
    "owner",
    "on_stale",
    "stale_grace",
    "tests"
  ],
  "additionalProperties": false,
  "if": {
    "properties": {
      "status": {
        "enum": [
          "active",
          "stale_authority",
          "suspended"
        ]
      }
    }
  },
  "then": {
    "required": [
      "reviewed_by",
      "effective_from"
    ]
  }
}