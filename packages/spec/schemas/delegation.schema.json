{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsor:schema:1.3:delegation",
  "title": "delegation",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "tenant": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/tenantId"
    },
    "delegator": {
      "type": "string"
    },
    "delegate": {
      "type": "string"
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "on_behalf_of",
          "unattended"
        ]
      }
    },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:dsor:schema:1.3:common#/$defs/permission"
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "per_transaction_limit": {
          "$ref": "urn:dsor:schema:1.3:common#/$defs/money"
        },
        "cumulative_limits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "window": {
                "$ref": "urn:dsor:schema:1.3:common#/$defs/duration"
              },
              "amount": {
                "$ref": "urn:dsor:schema:1.3:common#/$defs/money"
              }
            },
            "required": [
              "window",
              "amount"
            ],
            "additionalProperties": false
          }
        },
        "counterparties": {
          "type": "string"
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "time_window": {
          "type": "object",
          "properties": {
            "days": {
              "type": "array",
              "items": {
                "enum": [
                  "mon",
                  "tue",
                  "wed",
                  "thu",
                  "fri",
                  "sat",
                  "sun"
                ]
              }
            },
            "hours": {
              "type": "string",
              "pattern": "^[0-2][0-9]:[0-5][0-9]-[0-2][0-9]:[0-5][0-9]$"
            },
            "tz": {
              "type": "string"
            }
          },
          "required": [
            "days",
            "hours",
            "tz"
          ]
        }
      },
      "additionalProperties": false
    },
    "subdelegation": {
      "type": "object",
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "allowed"
      ],
      "if": {
        "properties": {
          "allowed": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "max_depth"
        ]
      }
    },
    "parent": {
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "suspended",
        "revoked",
        "expired"
      ]
    },
    "expires_at": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/timestamp"
    },
    "extensions": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/extensions"
    }
  },
  "required": [
    "id",
    "tenant",
    "delegator",
    "delegate",
    "modes",
    "permissions",
    "constraints",
    "subdelegation",
    "status",
    "expires_at"
  ],
  "additionalProperties": false
}