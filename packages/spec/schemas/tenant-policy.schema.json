{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsor:schema:1.3:tenant-policy",
  "title": "tenant-policy",
  "type": "object",
  "properties": {
    "tenant": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/tenantId"
    },
    "money": {
      "type": "object",
      "properties": {
        "control_currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "rate_source": {
          "type": "string"
        },
        "max_rate_age": {
          "$ref": "urn:dsor:schema:1.3:common#/$defs/duration"
        },
        "on_unconvertible": {
          "const": "restrictive"
        }
      },
      "required": [
        "control_currency",
        "rate_source",
        "max_rate_age",
        "on_unconvertible"
      ],
      "additionalProperties": false
    },
    "role_source": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "scim",
            "idp_lookup",
            "dsor_assignments"
          ]
        },
        "max_staleness": {
          "$ref": "urn:dsor:schema:1.3:common#/$defs/duration"
        }
      },
      "required": [
        "kind",
        "max_staleness"
      ]
    },
    "sod": {
      "type": "object",
      "properties": {
        "owner_approval": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "enabled_by": {
              "type": "string"
            },
            "ceiling": {
              "$ref": "urn:dsor:schema:1.3:common#/$defs/money"
            },
            "cooling_off": {
              "$ref": "urn:dsor:schema:1.3:common#/$defs/duration"
            },
            "notify": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "enabled"
          ],
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "enabled_by",
              "ceiling",
              "cooling_off",
              "notify"
            ]
          }
        }
      },
      "required": [
        "owner_approval"
      ]
    },
    "egress": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "public",
          "internal",
          "confidential",
          "restricted"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "external_provider": {
            "enum": [
              "allow",
              "allow_masked_identifiers",
              "deny"
            ]
          },
          "in_tenant": {
            "enum": [
              "allow",
              "allow_masked_identifiers",
              "deny"
            ]
          },
          "regions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "external_provider",
          "in_tenant"
        ]
      }
    },
    "residency": {
      "type": "object",
      "properties": {
        "control_plane": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "audit": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "control_plane",
        "audit",
        "events"
      ]
    },
    "extensions": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/extensions"
    }
  },
  "required": [
    "tenant",
    "money",
    "role_source",
    "sod",
    "egress",
    "residency"
  ],
  "additionalProperties": false
}