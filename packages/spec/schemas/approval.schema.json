{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsor:schema:1.3:approval",
  "title": "approval",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "proposal": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/resourceUri"
    },
    "operation": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/operationRef"
    },
    "tenant": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/tenantId"
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:dsor:schema:1.3:common#/$defs/resourceUri"
      }
    },
    "payload_hash": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/hash"
    },
    "risk": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/risk"
    },
    "bound_state": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "predicate",
            "strict_version"
          ]
        },
        "versions": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "integer",
              "string"
            ]
          }
        }
      },
      "required": [
        "mode",
        "versions"
      ],
      "additionalProperties": false
    },
    "satisfies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "control": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "requirement": {
            "$ref": "urn:dsor:schema:1.3:common#/$defs/approvalRequirement"
          }
        },
        "required": [
          "control",
          "version",
          "requirement"
        ],
        "additionalProperties": false
      }
    },
    "approvers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "principal": {
            "type": "string"
          },
          "basis": {
            "type": "string"
          },
          "authn": {
            "type": "object",
            "properties": {
              "acr": {
                "type": "string"
              },
              "at": {
                "$ref": "urn:dsor:schema:1.3:common#/$defs/timestamp"
              }
            },
            "required": [
              "at"
            ]
          }
        },
        "required": [
          "principal",
          "basis",
          "authn"
        ],
        "additionalProperties": false
      }
    },
    "sod_mode": {
      "enum": [
        "standard",
        "owner_approval"
      ]
    },
    "status": {
      "enum": [
        "active",
        "revoked",
        "expired",
        "consumed"
      ]
    },
    "expires_at": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/timestamp"
    },
    "extensions": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/extensions"
    }
  },
  "required": [
    "id",
    "proposal",
    "operation",
    "tenant",
    "resources",
    "payload_hash",
    "risk",
    "bound_state",
    "satisfies",
    "approvers",
    "sod_mode",
    "status",
    "expires_at"
  ],
  "additionalProperties": false,
  "if": {
    "properties": {
      "risk": {
        "const": "critical"
      }
    }
  },
  "then": {
    "properties": {
      "bound_state": {
        "properties": {
          "mode": {
            "const": "strict_version"
          }
        }
      }
    }
  }
}