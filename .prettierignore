# oxfmt reads this file. Prose and generated or normative JSON are not reformatted:
# the guard compares requirements.json byte-for-byte, and the schemas are normative.
pnpm-lock.yaml
*.md
packages/spec/schemas/
packages/spec/examples/
packages/spec/requirements.json

# Baby-step folders copy the normative schemas byte for byte, and say so in the step's
# README. Reformatting a copy would make that claim false and hide a real change in a
# diff of 115 whitespace-only lines.
docs/baby_steps_tutorials/*/src/schemas/
