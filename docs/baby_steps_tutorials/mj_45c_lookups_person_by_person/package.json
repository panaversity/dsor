{
  "name": "@dsor-steps/mj-45c-lookups-person-by-person",
  "version": "0.0.0",
  "private": true,
  "description": "Step 45c, learner build: DSoR spends a company's lookups person by person. It remembers every reply about a person for 10 seconds, waits longer each time her lookups keep failing, pauses a company only when different people's lookups fail, and gives people it knows nothing about a small budget (DSOR-IDN-06, DSOR-TEN-02a)",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "serve": "node src/serve.ts",
    "migrate": "node src/migrate.ts",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "verify-audit": "node src/verify-audit.ts",
    "checkpoint-keys": "node src/checkpoint-keys.ts",
    "checkpoint-audit": "node src/checkpoint-audit.ts",
    "send-events": "node src/send-events.ts"
  },
  "dependencies": {
    "@marcbachmann/cel-js": "8.0.0",
    "ajv": "8.20.0",
    "jose": "6.2.12",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.22.0"
}
