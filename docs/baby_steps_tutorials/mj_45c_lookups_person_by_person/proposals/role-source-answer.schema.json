{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsor:schema:1.3:role-source-answer",
  "title": "role-source-answer",
  "type": "object",
  "properties": {
    "tenant": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/tenantId"
    },
    "person": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "suspended",
        "gone"
      ]
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "as_of": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/timestamp"
    },
    "extensions": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/extensions"
    }
  },
  "required": [
    "tenant",
    "person",
    "status",
    "roles",
    "as_of"
  ],
  "if": {
    "properties": {
      "status": {
        "const": "active"
      }
    }
  },
  "else": {
    "properties": {
      "roles": {
        "maxItems": 0
      }
    }
  },
  "additionalProperties": false
}
