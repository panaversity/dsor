{
  "name": "@dsor-steps/mj-26-money-done-right",
  "version": "0.0.0",
  "private": true,
  "description": "Step 26 of the DSoR baby steps, a learner build: money in two currencies is compared exactly, with the company's own exchange rates, and when it cannot be converted, the strict answer wins.",
