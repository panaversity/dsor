{
  "id": "payment.execute",
  "version": 1,
  "kind": "command",
  "effect": "destructive",
  "input": { "schema": "PaymentExecuteRequest" },
  "output": { "schema": "Payment" },
  "authorization": { "permission": "payment:execute", "approve_permission": "payment:approve" },
  "tenancy": { "required": true },
  "delegation": { "required": true },
  "idempotency": { "required": true },
  "concurrency": { "strategy": "optimistic" },
  "execution": { "semantics": "non_compensatable" },
  "risk": { "level": "high" },
  "bind": {
    "invoice": "input.invoice",
    "vendor": "state.invoice.vendor_id",
    "payment": "input.payment"
  },
  "preconditions": {
    "freshness": "current",
    "predicates": ["state.invoice.status == \"issued\"", "state.vendor.status == \"approved\""]
  },
  "in_flight": { "exclusive_over": ["invoice"], "hold_on_unknown": ["payment", "invoice"] },
  "controls": [],
  "audit": { "level": "full" },
  "connector_requirements": { "downstream_idempotency_or_outcome_lookup": true }
}
