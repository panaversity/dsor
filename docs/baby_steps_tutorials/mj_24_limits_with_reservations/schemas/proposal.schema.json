{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsor:schema:1.3:proposal",
  "title": "proposal",
  "type": "object",
  "properties": {
    "uri": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/resourceUri"
    },
    "tenant": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/tenantId"
    },
    "operation": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/operationRef"
    },
    "mode": {
      "enum": [
        "execute",
        "propose_only"
      ]
    },
    "state": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/proposalState"
    },
    "payload": {
      "type": "object"
    },
    "payload_hash": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/hash"
    },
    "manifest_hash": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/hash"
    },
    "totals": {
      "type": "array",
      "items": {
        "$ref": "urn:dsor:schema:1.3:common#/$defs/money"
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "urn:dsor:schema:1.3:common#/$defs/resourceUri"
      }
    },
    "requester": {
      "$ref": "urn:dsor:schema:1.3:security-context"
    },
    "idempotency_key": {
      "type": "string"
    },
    "supersedes": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/resourceUri"
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "control": {
            "type": "string"
          },
          "control_version": {
            "type": "integer"
          },
          "approval": {
            "$ref": "urn:dsor:schema:1.3:common#/$defs/approvalRequirement"
          }
        },
        "required": [
          "control",
          "control_version"
        ]
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reservation": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "string"
        },
        "amount": {
          "$ref": "urn:dsor:schema:1.3:common#/$defs/money"
        },
        "state": {
          "enum": [
            "held",
            "committed",
            "released"
          ]
        }
      },
      "required": [
        "amount",
        "state"
      ]
    },
    "created_at": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/timestamp"
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "$ref": "urn:dsor:schema:1.3:common#/$defs/proposalState"
          },
          "to": {
            "$ref": "urn:dsor:schema:1.3:common#/$defs/proposalState"
          },
          "at": {
            "$ref": "urn:dsor:schema:1.3:common#/$defs/timestamp"
          },
          "actor": {
            "type": "string"
          },
          "cause": {
            "type": "string"
          }
        },
        "required": [
          "to",
          "at",
          "actor",
          "cause"
        ]
      }
    },
    "extensions": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/extensions"
    }
  },
  "required": [
    "uri",
    "tenant",
    "operation",
    "mode",
    "state",
    "payload",
    "payload_hash",
    "resources",
    "requester",
    "idempotency_key",
    "created_at",
    "transitions"
  ],
  "additionalProperties": false
}