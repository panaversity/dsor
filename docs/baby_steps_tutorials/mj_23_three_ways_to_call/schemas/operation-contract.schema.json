{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsor:schema:1.3:operation-contract",
  "title": "operation-contract",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/operationId"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": [
        "query",
        "command"
      ]
    },
    "effect": {
      "enum": [
        "read",
        "additive",
        "mutating",
        "destructive"
      ]
    },
    "input": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string"
        }
      },
      "required": [
        "schema"
      ]
    },
    "output": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string"
        }
      },
      "required": [
        "schema"
      ]
    },
    "authorization": {
      "type": "object",
      "properties": {
        "permission": {
          "$ref": "urn:dsor:schema:1.3:common#/$defs/permission"
        },
        "approve_permission": {
          "$ref": "urn:dsor:schema:1.3:common#/$defs/permission"
        }
      },
      "required": [
        "permission"
      ],
      "additionalProperties": false
    },
    "tenancy": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "required"
      ]
    },
    "delegation": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "required"
      ]
    },
    "idempotency": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "required"
      ]
    },
    "concurrency": {
      "type": "object",
      "properties": {
        "strategy": {
          "enum": [
            "optimistic",
            "pessimistic",
            "connector_managed",
            "none"
          ]
        }
      },
      "required": [
        "strategy"
      ]
    },
    "execution": {
      "type": "object",
      "properties": {
        "semantics": {
          "$ref": "urn:dsor:schema:1.3:common#/$defs/semantics"
        },
        "compensated_by": {
          "type": "array",
          "items": {
            "$ref": "urn:dsor:schema:1.3:common#/$defs/operationId"
          }
        }
      },
      "required": [
        "semantics"
      ]
    },
    "risk": {
      "type": "object",
      "properties": {
        "level": {
          "$ref": "urn:dsor:schema:1.3:common#/$defs/risk"
        }
      },
      "required": [
        "level"
      ]
    },
    "bind": {
      "type": "object",
      "additionalProperties": {
        "$ref": "urn:dsor:schema:1.3:common#/$defs/cel"
      }
    },
    "preconditions": {
      "type": "object",
      "properties": {
        "freshness": {
          "$ref": "urn:dsor:schema:1.3:common#/$defs/freshness"
        },
        "max_age_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "predicates": {
          "type": "array",
          "items": {
            "$ref": "urn:dsor:schema:1.3:common#/$defs/cel"
          }
        }
      },
      "required": [
        "freshness",
        "predicates"
      ],
      "additionalProperties": false
    },
    "in_flight": {
      "type": "object",
      "properties": {
        "exclusive_over": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hold_on_unknown": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sod": {
      "type": "object",
      "properties": {
        "incompatible_with": {
          "type": "array",
          "items": {
            "$ref": "urn:dsor:schema:1.3:common#/$defs/operationId"
          }
        }
      },
      "additionalProperties": false
    },
    "batch": {
      "type": "object",
      "properties": {
        "atomicity": {
          "enum": [
            "all_or_nothing",
            "per_item"
          ]
        },
        "max_items": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "atomicity",
        "max_items"
      ],
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "properties": {
        "level": {
          "enum": [
            "minimal",
            "standard",
            "full"
          ]
        }
      },
      "required": [
        "level"
      ]
    },
    "connector_requirements": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "extensions": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/extensions"
    }
  },
  "required": [
    "id",
    "version",
    "kind",
    "effect",
    "input",
    "output",
    "authorization",
    "tenancy",
    "risk",
    "audit"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "command"
          }
        }
      },
      "then": {
        "required": [
          "delegation",
          "idempotency",
          "concurrency",
          "execution",
          "preconditions",
          "controls"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "query"
          }
        }
      },
      "then": {
        "properties": {
          "effect": {
            "const": "read"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "semantics": {
                "enum": [
                  "compensatable",
                  "saga"
                ]
              }
            },
            "required": [
              "semantics"
            ]
          }
        },
        "required": [
          "execution"
        ]
      },
      "then": {
        "properties": {
          "execution": {
            "required": [
              "compensated_by"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "semantics": {
                "const": "non_compensatable"
              }
            },
            "required": [
              "semantics"
            ]
          }
        },
        "required": [
          "execution"
        ]
      },
      "then": {
        "required": [
          "in_flight"
        ],
        "properties": {
          "authorization": {
            "required": [
              "approve_permission"
            ]
          }
        }
      }
    }
  ]
}