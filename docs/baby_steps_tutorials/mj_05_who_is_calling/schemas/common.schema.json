{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsor:schema:1.3:common",
  "title": "common",
  "$defs": {
    "money": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "value",
        "currency"
      ],
      "additionalProperties": false
    },
    "resourceUri": {
      "type": "string",
      "pattern": "^dsor://[A-Za-z0-9_\\-]+/[a-z][a-z0-9_]*/[A-Za-z0-9_.\\-]+$"
    },
    "uri": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9+.\\-]*:.+$"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_\\-]+$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[A-Za-z0-9+/=_\\-]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "duration": {
      "type": "string",
      "pattern": "^P(?!$)([0-9]+D)?(T([0-9]+H)?([0-9]+M)?([0-9]+S)?)?$"
    },
    "operationRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+@[0-9]+$"
    },
    "operationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "permission": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*(\\.propose)?$"
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "semantics": {
      "enum": [
        "atomic",
        "compensatable",
        "saga",
        "best_effort",
        "non_compensatable"
      ]
    },
    "freshness": {
      "enum": [
        "current",
        "bounded_staleness",
        "observational",
        "connector_defined"
      ]
    },
    "outcome": {
      "enum": [
        "ALLOW",
        "DENY",
        "REQUIRE_APPROVAL",
        "REQUIRE_STEP_UP_AUTHENTICATION",
        "REQUIRE_VERIFICATION"
      ]
    },
    "identityMode": {
      "enum": [
        "direct",
        "on_behalf_of",
        "unattended"
      ]
    },
    "proposalState": {
      "enum": [
        "PROPOSED",
        "DENIED",
        "READY",
        "PENDING_APPROVAL",
        "APPROVED",
        "REJECTED",
        "EXPIRED",
        "CANCELLED",
        "REVOKED",
        "INVALIDATED",
        "EXECUTING",
        "COMMITTED",
        "FAILED",
        "OUTCOME_UNKNOWN",
        "COMPENSATING",
        "COMPENSATED",
        "COMPENSATION_FAILED"
      ]
    },
    "cel": {
      "type": "string",
      "minLength": 1,
      "description": "A CEL expression evaluated in the Appendix B environment."
    },
    "correlation": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string"
        },
        "trace_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "tenant_id": {
          "type": "string"
        },
        "agent_id": {
          "type": "string"
        },
        "principal_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        }
      },
      "required": [
        "request_id"
      ],
      "additionalProperties": false
    },
    "authorityReference": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string"
        },
        "uri": {
          "$ref": "urn:dsor:schema:1.3:common#/$defs/uri"
        },
        "rule": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "content_hash": {
          "$ref": "urn:dsor:schema:1.3:common#/$defs/hash"
        }
      },
      "required": [
        "system"
      ],
      "if": {
        "properties": {
          "system": {
            "const": "local"
          }
        }
      },
      "else": {
        "required": [
          "system",
          "uri",
          "version",
          "content_hash"
        ]
      },
      "additionalProperties": false
    },
    "approvalRequirement": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string"
        },
        "quorum": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "role",
        "quorum"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9\\-]+(\\.[a-z0-9\\-]+)+$"
      }
    }
  }
}