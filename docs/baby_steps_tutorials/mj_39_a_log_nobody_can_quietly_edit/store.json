{
  "schemas": {
    "app": {
      "side": "company",
      "runtime": ["USAGE"]
    },
    "dsor": {
      "side": "dsor",
      "runtime": ["USAGE"]
    },
    "public": {
      "side": "none",
      "runtime": ["USAGE"]
    }
  },
  "tables": {
    "app.invoices": {
      "kind": "business",
      "tenant": "tenant_id",
      "runtime": {
        "table": ["SELECT"]
      },
      "triggers": [
        "CREATE TRIGGER invoices_version BEFORE UPDATE ON app.invoices FOR EACH ROW EXECUTE FUNCTION app.next_version()"
      ]
    },
    "app.vendors": {
      "kind": "business",
      "tenant": "tenant_id",
      "runtime": {
        "table": ["SELECT"]
      },
      "triggers": [
        "CREATE TRIGGER vendors_version BEFORE UPDATE ON app.vendors FOR EACH ROW EXECUTE FUNCTION app.next_version()"
      ]
    },
    "app.payments": {
      "kind": "business-written",
      "tenant": "tenant_id",
      "runtime": {
        "table": ["SELECT"],
        "columns": {
          "INSERT": [
            "tenant_id",
            "invoice_id",
            "vendor_id",
            "amount_value",
            "amount_currency",
            "status"
          ],
          "UPDATE": ["status"]
        }
      },
      "triggers": [
        "CREATE TRIGGER payments_version BEFORE UPDATE ON app.payments FOR EACH ROW EXECUTE FUNCTION app.next_version()"
      ]
    },
    "dsor.audit": {
      "kind": "append-only-chained",
      "tenant": "tenant",
      "runtime": {
        "table": ["SELECT"],
        "columns": {
          "INSERT": [
            "record_id",
            "kind",
            "operation",
            "authorization",
            "result",
            "reason",
            "correlation",
            "tenant",
            "extensions",
            "resources",
            "row_count",
            "connector",
            "identity",
            "delegation",
            "controls",
            "decision_bundle"
          ]
        }
      },
      "triggers": [
        "CREATE CONSTRAINT TRIGGER audit_chain AFTER INSERT ON dsor.audit DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION dsor.audit_chains()"
      ]
    },
    "dsor.delegations": {
      "kind": "control-written",
      "tenant": "tenant_id",
      "runtime": {
        "table": ["SELECT"],
        "columns": {
          "UPDATE": ["status"]
        }
      }
    },
    "dsor.idempotency": {
      "kind": "control-claimed",
      "tenant": "tenant_id",
      "runtime": {
        "table": ["SELECT"],
        "columns": {
          "INSERT": [
            "tenant_id",
            "principal",
            "operation",
            "idempotency_key",
            "payload_hash",
            "request_id",
            "mode"
          ],
          "UPDATE": ["answer"]
        }
      }
    },
    "dsor.proposals": {
      "kind": "control-moved",
      "tenant": "tenant_id",
      "runtime": {
        "table": ["SELECT"],
        "columns": {
          "INSERT": [
            "tenant_id",
            "id",
            "operation",
            "mode",
            "state",
            "payload",
            "payload_hash",
            "resources",
            "requester",
            "idempotency_key",
            "expires_at",
            "exclusive_over"
          ],
          "UPDATE": ["state", "requires"]
        }
      },
      "triggers": [
        "CREATE TRIGGER proposals_alert AFTER UPDATE OF state ON dsor.proposals FOR EACH ROW EXECUTE FUNCTION dsor.proposal_alerts()",
        "CREATE TRIGGER proposals_move BEFORE INSERT OR UPDATE ON dsor.proposals FOR EACH ROW EXECUTE FUNCTION dsor.proposal_moves()"
      ]
    },
    "dsor.limit_counters": {
      "kind": "control-claimed",
      "tenant": "tenant_id",
      "runtime": {
        "table": ["SELECT"],
        "columns": {
          "INSERT": ["tenant_id", "delegation", "day", "currency", "used"],
          "UPDATE": ["used"]
        }
      }
    },
    "dsor.reservations": {
      "kind": "control-claimed",
      "tenant": "tenant_id",
      "runtime": {
        "table": ["SELECT"],
        "columns": {
          "INSERT": [
            "tenant_id",
            "proposal_id",
            "delegation",
            "day",
            "amount_value",
            "amount_currency",
            "state"
          ],
          "UPDATE": ["state"]
        }
      }
    },
    "dsor.brakes": {
      "kind": "control-claimed",
      "tenant": "tenant_id",
      "runtime": {
        "table": ["SELECT"],
        "columns": {
          "INSERT": ["tenant_id", "id", "agent", "pulled_by", "reason"],
          "UPDATE": ["lifted_by", "lifted_at", "lift_reason"]
        }
      }
    },
    "dsor.rates": {
      "kind": "append-only",
      "tenant": "tenant_id",
      "runtime": {
        "table": ["SELECT"],
        "columns": {
          "INSERT": ["tenant_id", "source", "published_at", "base", "currency", "per_base"]
        }
      }
    },
    "dsor.controls": {
      "kind": "control-moved",
      "tenant": "tenant_id",
      "runtime": {
        "table": ["SELECT"],
        "columns": {
          "INSERT": ["tenant_id", "id", "version", "status", "rule", "compiled_by"],
          "UPDATE": ["status", "reviewed_by", "effective_from", "in_force"]
        }
      },
      "triggers": [
        "CREATE TRIGGER controls_move BEFORE UPDATE ON dsor.controls FOR EACH ROW EXECUTE FUNCTION dsor.control_moves()"
      ]
    },
    "dsor.notices": {
      "kind": "append-only",
      "tenant": "tenant_id",
      "runtime": {
        "table": ["SELECT"],
        "columns": {
          "INSERT": [
            "notice_id",
            "tenant_id",
            "to_person",
            "rule_id",
            "version",
            "words",
            "correlation"
          ]
        }
      }
    },
    "dsor.approvals": {
      "kind": "append-only",
      "tenant": "tenant_id",
      "runtime": {
        "table": ["SELECT"],
        "columns": {
          "INSERT": ["tenant_id", "id", "proposal_id", "approver", "approval"]
        }
      }
    },
    "dsor.decision_bundles": {
      "kind": "append-only",
      "tenant": "tenant_id",
      "runtime": {
        "table": ["SELECT"],
        "columns": {
          "INSERT": ["decision_id", "tenant_id", "bundle"]
        }
      }
    },
    "dsor.holds": {
      "kind": "append-only",
      "tenant": "tenant_id",
      "runtime": {
        "table": ["SELECT"],
        "columns": { "INSERT": ["tenant_id", "resource", "proposal_id"] }
      }
    },
    "dsor.alerts": {
      "kind": "control-moved",
      "tenant": "tenant_id",
      "runtime": {
        "table": ["SELECT"],
        "columns": {
          "UPDATE": ["state", "escalated_to"]
        }
      },
      "triggers": [
        "CREATE TRIGGER alerts_move BEFORE INSERT OR DELETE OR UPDATE ON dsor.alerts FOR EACH ROW EXECUTE FUNCTION dsor.alert_moves()",
        "CREATE TRIGGER alerts_stay BEFORE TRUNCATE ON dsor.alerts FOR EACH STATEMENT EXECUTE FUNCTION dsor.alerts_stay()"
      ]
    },
    "dsor.intents": {
      "kind": "control-moved",
      "tenant": "tenant_id",
      "runtime": {
        "table": ["SELECT"],
        "columns": {
          "INSERT": [
            "proposal_id",
            "tenant_id",
            "operation",
            "payload_hash",
            "principal",
            "claim_operation",
            "idempotency_key",
            "connector",
            "security_context"
          ],
          "UPDATE": ["outcome"]
        }
      },
      "triggers": [
        "CREATE TRIGGER intents_end BEFORE UPDATE ON dsor.intents FOR EACH ROW EXECUTE FUNCTION dsor.intent_ends()"
      ]
    },
    "dsor.audit_heads": {
      "kind": "bookkeeping",
      "tenant": null,
      "runtime": {
        "table": []
      }
    },
    "dsor.migrations": {
      "kind": "bookkeeping",
      "tenant": null,
      "runtime": {
        "table": []
      }
    }
  }
}
