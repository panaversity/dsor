{
  "name": "@dsor-steps/mj-43c-company-role-source",
  "version": "0.0.0",
  "private": true,
  "description": "Step 43c, learner build: a company on its own directory. authentik pushes its people and groups to DSoR by SCIM; DSoR keeps a copy, reads a role map by group uuid, and refuses a copy older than max_staleness.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "serve": "node src/serve.ts",
    "invite": "node src/invite.ts",
    "grant": "node src/grant.ts",
    "dev-issuer": "node src/dev-issuer.ts",
    "migrate": "node src/migrate.ts",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "verify-audit": "node src/verify-audit.ts",
    "checkpoint-keys": "node src/checkpoint-keys.ts",
    "checkpoint-audit": "node src/checkpoint-audit.ts",
    "send-events": "node src/send-events.ts"
  },
  "dependencies": {
    "@marcbachmann/cel-js": "8.0.0",
    "ajv": "8.20.0",
    "jose": "6.2.12",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.22.0"
}
