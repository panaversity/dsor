# Copy this file to `.env` and put your own Neon connection strings in it.
# `.env` is in .gitignore and must never be committed. `.env.example` has no secrets.
#
# Neon gives you a connection string that looks like:
#   postgresql://USER:PASSWORD@ep-something-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require
#
# TWO users, because that is the whole point of this step.
#
# The owner. Used ONLY by `pnpm migrate`, to create and change tables. This is the
# connection string Neon gives you when you create the project.
DSOR_DB_OWNER_URL=
#
# The application. Used by the program and by the tests. It may INSERT audit rows and
# it may NOT update or delete them — migration 003 is what takes those rights away.
# Same host and database as the owner, different user and password.
DSOR_DB_URL=
