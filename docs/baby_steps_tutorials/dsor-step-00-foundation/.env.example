# Copy to .env for the database test tier (pnpm test:db) and for baby steps 09 onward.
# Never commit .env. Claude Code is configured not to read it.
#
# Neon: use the connection string of a role you created WITH SQL (for example
# dsor_runtime). Roles created in the Neon Console, including neondb_owner, bypass
# row-level security, so tests run as them prove nothing (AGENTS.md → decision 14).
DSOR_DB_URL=postgresql://dsor_runtime:change-me@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# The owner role, used only to run migrations.
DSOR_DB_MIGRATION_URL=postgresql://neondb_owner:change-me@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Any PostgreSQL 17 works for steps 09 to 42, for example one on your own computer:
# DSOR_DB_URL=postgres://dsor_runtime:dsor@localhost:5432/dsor_test
