{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsor:schema:1.3:audit-record",
  "title": "audit-record",
  "type": "object",
  "properties": {
    "record_id": {
      "type": "string"
    },
    "chain": {
      "type": "string"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "previous_hash": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/hash"
    },
    "record_hash": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/hash"
    },
    "at": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/timestamp"
    },
    "tenant": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/tenantId"
    },
    "kind": {
      "enum": [
        "decision",
        "proposal_transition",
        "classified_read",
        "control_change",
        "operational_control",
        "delegation_change",
        "reconciliation",
        "policy_change"
      ]
    },
    "identity": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "urn:dsor:schema:1.3:common#/$defs/identityMode"
        },
        "subject": {
          "type": "string"
        },
        "actor_chain": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subject_authority": {
          "type": "object",
          "properties": {
            "source": {
              "enum": [
                "token",
                "role_source"
              ]
            },
            "as_of": {
              "$ref": "urn:dsor:schema:1.3:common#/$defs/timestamp"
            }
          },
          "required": [
            "source",
            "as_of"
          ]
        }
      },
      "required": [
        "mode",
        "subject",
        "actor_chain",
        "subject_authority"
      ],
      "additionalProperties": false
    },
    "delegation": {
      "type": "string"
    },
    "operation": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/operationRef"
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "urn:dsor:schema:1.3:common#/$defs/resourceUri"
      }
    },
    "payload_hash": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/hash"
    },
    "authorization": {
      "enum": [
        "ALLOW",
        "DENY"
      ]
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "superseded_version": {
            "type": "integer"
          },
          "outcome": {
            "$ref": "urn:dsor:schema:1.3:common#/$defs/outcome"
          },
          "satisfied_by": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "authority": {
            "$ref": "urn:dsor:schema:1.3:common#/$defs/authorityReference"
          },
          "evaluation_error": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "version",
          "outcome",
          "authority"
        ],
        "additionalProperties": false
      }
    },
    "approval": {
      "type": "string"
    },
    "connector": {
      "type": "string"
    },
    "semantics": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/semantics"
    },
    "result": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "row_count": {
      "type": "integer",
      "minimum": 0
    },
    "decision_bundle": {
      "type": "string"
    },
    "correlation": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/correlation"
    },
    "extensions": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/extensions"
    }
  },
  "required": [
    "record_id",
    "chain",
    "sequence",
    "previous_hash",
    "record_hash",
    "at",
    "tenant",
    "kind",
    "identity",
    "result",
    "correlation"
  ],
  "additionalProperties": false
}