{
  "name": "@dsor-steps/mj-40-events-with-an-outbox",
  "version": "0.0.0",
  "private": true,
  "description": "Step 40, learner build: every domain event is written to an outbox in the same transaction as the change it reports, and a separate sender delivers it at least once (DSOR-EVT-01a, DSOR-EVT-01b, DSOR-COR-01a)",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "migrate": "node src/migrate.ts",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "verify-audit": "node src/verify-audit.ts",
    "checkpoint-keys": "node src/checkpoint-keys.ts",
    "checkpoint-audit": "node src/checkpoint-audit.ts"
  },
  "dependencies": {
    "@marcbachmann/cel-js": "8.0.0",
    "ajv": "8.20.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.22.0"
}
