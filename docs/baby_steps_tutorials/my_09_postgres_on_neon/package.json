{
  "name": "@dsor-steps/09-postgres-on-neon",
  "version": "0.0.0",
  "private": true,
  "description": "DSoR baby step 09 - the audit log moves into a real database, and the application may not rewrite it",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
