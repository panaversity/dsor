{
  "name": "@dsor-steps/mj-42-a-rest-api",
  "version": "0.0.0",
  "private": true,
  "description": "Step 42, learner build: an HTTP server over the same pipeline; every route hands its request to call() and holds no check of its own (DSOR-OPR-04a, DSOR-OPR-04b)",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "migrate": "node src/migrate.ts",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "verify-audit": "node src/verify-audit.ts",
    "checkpoint-keys": "node src/checkpoint-keys.ts",
    "checkpoint-audit": "node src/checkpoint-audit.ts",
    "send-events": "node src/send-events.ts"
  },
  "dependencies": {
    "@marcbachmann/cel-js": "8.0.0",
    "ajv": "8.20.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.22.0"
}
