{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsor:schema:1.3:error-envelope",
  "title": "error-envelope",
  "type": "object",
  "properties": {
    "code": {
      "anyOf": [
        {
          "enum": [
            "AUTHENTICATION_REQUIRED",
            "AUTHORIZATION_DENIED",
            "DELEGATION_REQUIRED",
            "DELEGATION_EXPIRED",
            "DELEGATION_REVOKED",
            "TENANT_MISMATCH",
            "RESOURCE_NOT_FOUND",
            "VALIDATION_FAILED",
            "POLICY_DENIED",
            "SOD_VIOLATION",
            "LIMIT_EXCEEDED",
            "AGENT_SUSPENDED",
            "OPERATION_FROZEN",
            "APPROVAL_REQUIRED",
            "APPROVAL_EXPIRED",
            "APPROVAL_MISMATCH",
            "APPROVAL_INVALIDATED",
            "COOLING_OFF_ACTIVE",
            "CONFLICT",
            "STALE_STATE",
            "IDEMPOTENCY_CONFLICT",
            "RESOURCE_HELD",
            "OUTCOME_UNKNOWN",
            "FRESHNESS_UNSATISFIABLE",
            "BATCH_PARTIAL",
            "RATE_LIMITED",
            "CONNECTOR_UNAVAILABLE",
            "DEPENDENCY_TIMEOUT",
            "TRANSACTION_FAILED",
            "EVIDENCE_STORE_UNAVAILABLE",
            "UNSUPPORTED_CAPABILITY",
            "INTERNAL_ERROR"
          ]
        },
        {
          "type": "string",
          "pattern": "^X_[A-Z0-9_]+$",
          "description": "documented extension code"
        }
      ]
    },
    "message": {
      "type": "string"
    },
    "retry": {
      "enum": [
        "safe_same_key",
        "after_delay",
        "after_state_refresh",
        "after_reconciliation",
        "per_item",
        "never"
      ]
    },
    "retry_after_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "proposal": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/resourceUri"
    },
    "cause": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "correlation": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/correlation"
    },
    "extensions": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/extensions"
    }
  },
  "required": [
    "code",
    "message",
    "retry",
    "correlation"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "code": {
            "enum": [
              "OUTCOME_UNKNOWN",
              "RESOURCE_HELD"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "retry": {
            "const": "after_reconciliation"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "BATCH_PARTIAL"
          }
        }
      },
      "then": {
        "required": [
          "items"
        ],
        "properties": {
          "retry": {
            "const": "per_item"
          }
        }
      }
    }
  ]
}