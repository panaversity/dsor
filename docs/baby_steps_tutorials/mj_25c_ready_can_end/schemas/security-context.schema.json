{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsor:schema:1.3:security-context",
  "title": "security-context",
  "type": "object",
  "properties": {
    "identity_mode": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/identityMode"
    },
    "subject": {
      "type": "string"
    },
    "subject_type": {
      "enum": [
        "human",
        "agent",
        "application",
        "system"
      ]
    },
    "actor_chain": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "active_tenant": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/tenantId"
    },
    "delegation": {
      "type": "string"
    },
    "authn": {
      "type": "object",
      "properties": {
        "acr": {
          "type": "string"
        },
        "amr": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "auth_time": {
          "$ref": "urn:dsor:schema:1.3:common#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "token_scopes": {
      "type": "array",
      "items": {
        "$ref": "urn:dsor:schema:1.3:common#/$defs/permission"
      }
    },
    "subject_authority": {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "token",
            "role_source"
          ]
        },
        "as_of": {
          "$ref": "urn:dsor:schema:1.3:common#/$defs/timestamp"
        }
      },
      "required": [
        "source",
        "as_of"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "$ref": "urn:dsor:schema:1.3:common#/$defs/extensions"
    }
  },
  "required": [
    "identity_mode",
    "subject",
    "subject_type",
    "actor_chain",
    "active_tenant",
    "subject_authority"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "identity_mode": {
            "const": "unattended"
          }
        }
      },
      "then": {
        "required": [
          "delegation"
        ],
        "properties": {
          "subject_authority": {
            "properties": {
              "source": {
                "const": "role_source"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "identity_mode": {
            "const": "direct"
          }
        }
      },
      "then": {
        "properties": {
          "actor_chain": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}