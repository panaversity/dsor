# Copy this file to .env and fill in both values (step 09's README, "Before you build").
# .env is ignored by git. This file holds only the names.

# The owner of the tables. Used only by `pnpm migrate`.
DSOR_MIGRATION_URL=
# dsor_runtime, which the program and the tests log in as. The migration creates it
# with the password written here.
DSOR_DB_URL=
